# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8000
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=7000 

# Use this to set FreeRTOS kernel tick frequency to 1000 Hz (100 Hz by default).
# This allows to use 1 ms granuality for thread sleeps (10 ms by default).
CONFIG_FREERTOS_HZ=1000

# Workaround for https://github.com/espressif/esp-idf/issues/7631
#CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
#CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=n

CONFIG_ESP_TASK_WDT_EN=n

# CPU frequency 40, 80, 160
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=80

# BLE
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y

# Controller power save
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y

# NimBLE role trimming - keyboard is peripheral only
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y

# Bonding - keyboards need it for reconnection.
# One host per BLE profile (protocol::config::BT_PROFILES = 4) and spare slots: a host pairing on a taken
# profile is bonded before it's rejected, and a full store makes NimBLE remove the oldest bond.
CONFIG_BT_NIMBLE_MAX_BONDS=8
# Subscriptions of the bonded hosts: up to 6 per host (3 HID reports, battery, Service Changed, config).
# When full NimBLE removes the bond of another host (ble_store_util_status_rr), so it has room for all.
CONFIG_BT_NIMBLE_MAX_CCCDS=32
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# Security - HID requires bonding and encryption
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y

# System power management
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_DFS_INIT_AUTO=y
#CONFIG_PM_POWER_DOWN_PERIPHERAL_IN_LIGHT_SLEEP=y crash

# Reconnection
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# Unused: every BLE profile has its own static random address, no RPA (see keyboard/src/bt/profiles.rs).
CONFIG_BT_NIMBLE_RPA_TIMEOUT=900